{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:test": "cross-env NODE_ENV=test knex migrate:latest",
    "test": "node --test \"test/*.test.js\"",
    "pretest:db": "cross-env NODE_ENV=test node db-tests/clean.js",
    "test:db": "cross-env NODE_ENV=test node --test --test-concurrency=1 \"db-tests/*.spec.js\"",
    "db:reset": "node db/reset-dev.js",
    "db:reset:test": "cross-env NODE_ENV=test node db/reset-dev.js",
    "seed": "knex seed:run",
    "seed:test": "cross-env NODE_ENV=test knex seed:run",
    "test:count": "node ../scripts/count-tests.js",
    "demo:reviews": "node scripts/prepare-review-demo.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "pdf-parse": "^2.4.5"
  }
}
